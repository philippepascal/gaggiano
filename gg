#!/usr/bin/env bash
# Gaggiano build/flash entry point. Wraps arduino-cli with the pinned cores and
# board options from tools/targets.sh. Run ./gg help.
set -euo pipefail

REPO="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
CFG="$REPO/tools/arduino-cli.yaml"
BUILD_DIR="$REPO/build"
DETECT="$REPO/tools/usb-detect.py"
# shellcheck source=tools/targets.sh
. "$REPO/tools/targets.sh"

CUBE_CLI_APP="/Applications/STMicroelectronics/STM32Cube/STM32CubeProgrammer/STM32CubeProgrammer.app/Contents/MacOs/bin"

# ---------- helpers ----------------------------------------------------------

log()  { printf '\033[1;34m==>\033[0m %s\n' "$*"; }
warn() { printf '\033[1;33mwarning:\033[0m %s\n' "$*" >&2; }
die()  { printf '\033[1;31merror:\033[0m %s\n' "$*" >&2; exit 1; }

cli() {
  [ -f "$CFG" ] || die "missing $CFG: run ./gg setup first"
  arduino-cli --config-file "$CFG" "$@"
}

need_target() {
  [ $# -ge 1 ] || die "missing target (one of: $ALL_TARGETS, all)"
  target_load "$1" || die "unknown target '$1' (one of: $ALL_TARGETS, all)"
}

# Expands "all" into the target list, otherwise validates the single target.
expand_targets() {
  if [ "${1:-}" = "all" ]; then echo "$ALL_TARGETS"; else need_target "${1:-}"; echo "$1"; fi
}

usb_specs() {  # all "target:state=vid:pid" specs for every target
  local t s
  for t in $ALL_TARGETS; do
    target_load "$t"
    for s in $T_USB; do echo "$t:$s"; done
  done
}

detect_present() { "$DETECT" --config-file "$CFG" $(usb_specs) --present "$1" "$2"; }
detect_port()    { "$DETECT" --config-file "$CFG" $(usb_specs) --port "$1" "$2"; }

# Cores, toolchains and package indexes live inside the repo (git-ignored) so
# nothing depends on the Arduino IDE's own data directory.
data_dir() { echo "$REPO/.arduino-data"; }

write_config() {
  local data; data="$(data_dir)"
  cat > "$CFG" <<YAML
# Repo-local arduino-cli configuration, generated by ./gg setup. Do not edit paths
# by hand; re-run ./gg setup after moving the repo.
board_manager:
  additional_urls:
    - $STM32_INDEX_URL
    - $ESP32_INDEX_URL
directories:
  data: $data
  downloads: $data/staging
  user: $REPO
sketch:
  always_export_binaries: false
updater:
  enable_notification: false
YAML
}

installed_core_version() {  # prints installed version of core id, or nothing
  cli core list --format json 2>/dev/null | python3 -c '
import json,sys
want=sys.argv[1]
d=json.load(sys.stdin)
for p in d.get("platforms", []):
    if p.get("id")==want:
        v=p.get("installed_version") or (p.get("installed") if isinstance(p.get("installed"),str) else "")
        print(v or ""); break
' "$1"
}

cube_cli() {  # prints path to STM32_Programmer_CLI or fails
  if command -v STM32_Programmer_CLI >/dev/null 2>&1; then command -v STM32_Programmer_CLI; return; fi
  [ -x "$CUBE_CLI_APP/STM32_Programmer_CLI" ] && { echo "$CUBE_CLI_APP/STM32_Programmer_CLI"; return; }
  return 1
}

# ---------- commands ---------------------------------------------------------

cmd_setup() {
  local ci=0; [ "${1:-}" = "--ci" ] && ci=1
  if ! command -v arduino-cli >/dev/null 2>&1; then
    if [ "$(uname -s)" = Darwin ] && command -v brew >/dev/null 2>&1; then
      log "installing arduino-cli with Homebrew"; brew install arduino-cli
    else
      die "arduino-cli not found. Install it: https://arduino.github.io/arduino-cli/latest/installation/"
    fi
  fi
  log "arduino-cli $(arduino-cli version | awk '{print $3}')"
  log "writing $CFG (data dir: $(data_dir))"; mkdir -p "$(data_dir)"; write_config
  log "updating package indexes"; cli core update-index >/dev/null
  local t have
  for t in $ALL_TARGETS; do
    target_load "$t"
    have="$(installed_core_version "${T_CORE%@*}")"
    if [ "$have" = "${T_CORE#*@}" ]; then
      log "core $T_CORE already installed"
    else
      log "installing core $T_CORE (found '${have:-none}')"; cli core install "$T_CORE"
    fi
  done
  if [ "$ci" = 0 ]; then
    if p="$(cube_cli)"; then log "STM32CubeProgrammer CLI: $p"
    else warn "STM32CubeProgrammer CLI not found; needed for 'flash controller'. Install from https://www.st.com/en/development-tools/stm32cubeprog.html"; fi
    command -v python3 >/dev/null 2>&1 || warn "python3 not found; 'detect' and 'flash controller' need it"
    command -v st-flash >/dev/null 2>&1 && log "st-flash present (optional SWD path)"
  fi
  log "done. Try: ./gg build all"
}

cmd_build() {
  local targets extra=() t
  targets="$(expand_targets "${1:-}")"; shift || true
  extra=("$@")   # e.g. --clean, --verbose
  for t in $targets; do
    target_load "$t"
    [ "$t" = screen ] && python3 "$REPO/tools/embed-web.py"
    log "building $t ($T_SKETCH)"
    cli compile --fqbn "$T_FQBN" --build-property "$COMMON_BUILD_PROPS" \
      --warnings default --output-dir "$BUILD_DIR/$t" ${extra[@]+"${extra[@]}"} "$REPO/$T_SKETCH"
    ls -l "$BUILD_DIR/$t"/*.bin | awk '{printf "    %8d  %s\n", $5, $9}'
  done
}

cmd_sim() {
  log "building the screen simulator"
  make -s -C "$REPO/sim" || die "simulator build failed (needs: brew install sdl2)"
  if [ "${1:-}" = "--shot" ]; then
    local out="${2:-shot.bmp}"
    (cd "$REPO/sim" && ./build/gaggiano-sim --shot "$out")
    case "$out" in *.png) ;; *) return 0 ;; esac
  else
    log "running (q to quit, w for a screenshot, t/T p/P readings)"
    (cd "$REPO/sim" && ./build/gaggiano-sim)
  fi
}

cmd_test() {
  log "running host tests"
  make -C "$REPO/tests" "$@"
}

cmd_clean() {
  log "removing $BUILD_DIR"; rm -rf "$BUILD_DIR"
  local t
  if [ -f "$CFG" ]; then
    for t in $ALL_TARGETS; do
      target_load "$t"
      cli compile --fqbn "$T_FQBN" --clean --only-compilation-database "$REPO/$T_SKETCH" >/dev/null 2>&1 || true
    done
  fi
  if [ "${1:-}" = "--all" ]; then
    log "removing $(data_dir) and $CFG"; rm -rf "$(data_dir)" "$CFG"
  fi
}

cmd_detect() {
  "$DETECT" --config-file "$CFG" $(usb_specs) "$@"
}

cmd_monitor() {
  need_target "${1:-}"; shift || true
  local port="${1:-}"
  if [ -z "$port" ]; then
    port="$(detect_port "$T_NAME" run)" || die "no $T_NAME serial port found (./gg detect)"
  fi
  log "monitor $T_NAME on $port at $T_BAUD (ctrl-c to quit)"
  cli monitor -p "$port" -c "baudrate=$T_BAUD"
}

# Waits until "target state" is present. $3 = timeout seconds. Returns 1 on timeout.
wait_for() {
  local t="$1" s="$2" timeout="$3" i=0
  while ! detect_present "$t" "$s"; do
    i=$((i + 1)); [ "$i" -ge $((timeout * 2)) ] && return 1
    sleep 0.5
  done
}

flash_screen() {
  local port="${PORT:-}"
  local fqbn="$T_FQBN"
  [ "${ERASE:-0}" = 1 ] && fqbn="$(printf '%s' "$T_FQBN" | sed 's/EraseFlash=none/EraseFlash=all/')"
  if [ -z "$port" ]; then
    port="$(detect_port screen run)" || die "screen not found: plug the display's USB (CH340) port in, or pass --port"
  fi
  # macOS + CH340 often fails the first open after plug-in with
  # "Could not configure port: (6, 'Device not configured')". Retry, and use the
  # slow rate on the last attempt.
  local attempt fqbn
  local base="$fqbn"
  for attempt in 1 2 3; do
    fqbn="$base"
    [ "$attempt" = 3 ] && fqbn="$(printf '%s' "$base" | sed 's/UploadSpeed=[0-9]*/UploadSpeed=115200/')"
    log "flashing screen on $port (attempt $attempt$([ "$attempt" = 3 ] && echo ', 115200 baud'))"
    if cli upload --fqbn "$fqbn" -p "$port" --input-dir "$BUILD_DIR/screen" "$REPO/$T_SKETCH"; then
      log "screen flashed"; return 0
    fi
    warn "upload failed"; sleep 2
  done
  die "screen upload failed after 3 attempts (see docs/BUILD.md, troubleshooting)"
}

flash_controller_dfu() {
  local timeout="${TIMEOUT:-60}" attempt
  cube_cli >/dev/null || die "STM32CubeProgrammer CLI not found (./gg setup)"
  if detect_present controller dfu; then
    log "controller already in DFU mode"
  else
    if detect_present controller run && [ "${NO_SERIAL_DFU:-0}" = 0 ]; then
      local port
      if port="$(detect_port controller run)"; then
        log "asking the running firmware to reboot into DFU via $port"
        "$REPO/tools/serial-cmd.py" -t 1 -b "$T_BAUD" "$port" DFU >/dev/null || warn "could not send DFU command"
        if wait_for controller dfu 5; then log "controller entered DFU"; fi
      fi
    fi
    if ! detect_present controller dfu; then
      cat <<TXT

  Put the Black Pill into DFU mode:
    1. hold BOOT0
    2. press and release NRST
    3. release BOOT0
  If nothing shows up: try a direct USB port (no hub), another cable, and
  note the solenoid relay can block DFU enumeration (turn brew on first).

TXT
      log "waiting up to ${timeout}s for the DFU bootloader (0483:df11)..."
      wait_for controller dfu "$timeout" || die "timed out waiting for DFU device"
      log "DFU bootloader detected"
    fi
  fi
  for attempt in 1 2 3; do
    log "download attempt $attempt"
    if cli upload --fqbn "$T_FQBN" --input-dir "$BUILD_DIR/controller" "$REPO/$T_SKETCH"; then
      log "controller flashed, waiting for it to come back"
      if wait_for controller run 10; then log "controller is back on $(detect_port controller run)"
      else warn "controller did not re-enumerate within 10s; press NRST"; fi
      return 0
    fi
    warn "download failed"; sleep 1
  done
  die "flashing failed after 3 attempts (see docs/FLASH-STM32.md)"
}

flash_controller_stlink() {
  command -v st-flash >/dev/null 2>&1 || die "st-flash not found (brew install stlink)"
  log "flashing controller over SWD with st-flash"
  st-flash --reset write "$BUILD_DIR/controller/$T_SKETCH.ino.bin" 0x8000000
}

cmd_flash() {
  need_target "${1:-}"; shift || true
  local via="$T_FLASH" build=1
  while [ $# -gt 0 ]; do
    case "$1" in
      --via) via="$2"; shift 2 ;;
      --port) PORT="$2"; shift 2 ;;
      --timeout) TIMEOUT="$2"; shift 2 ;;
      --erase) ERASE=1; shift ;;
      --no-build) build=0; shift ;;
      --no-serial-dfu) NO_SERIAL_DFU=1; shift ;;
      *) die "unknown option $1" ;;
    esac
  done
  [ "$build" = 1 ] && cmd_build "$T_NAME"
  [ -d "$BUILD_DIR/$T_NAME" ] || die "no build for $T_NAME (run ./gg build $T_NAME)"
  case "$T_NAME:$via" in
    screen:esptool)    flash_screen ;;
    controller:dfu)    flash_controller_dfu ;;
    controller:stlink) flash_controller_stlink ;;
    *) die "target $T_NAME cannot be flashed via '$via'" ;;
  esac
}

cmd_help() {
  cat <<TXT
usage: ./gg <command> [args]

  setup [--ci]           install/pin cores, write tools/arduino-cli.yaml, check tools
  build <target|all> [--clean] [--verbose]
                         compile into build/<target>/
  flash <target> [--no-build] [--port P] [--timeout S] [--via dfu|stlink|esptool]
                         [--no-serial-dfu] [--erase (screen: wipe the whole flash first)]
                         build then program the board (see docs/FLASH-STM32.md)
  detect [--json]        list connected project boards and their ports
  monitor <target> [port]
                         serial monitor at the target's baud rate
  test                   build and run the host-side tests in tests/
  sim [--shot FILE.bmp]  run the screen UI in an SDL window on the Mac (or save a screenshot)
  clean [--all]          remove build/ and the compile caches; --all also removes
                         .arduino-data/ (cores and toolchains, re-downloaded by setup)
  help

targets:
TXT
  local t
  for t in $ALL_TARGETS; do target_load "$t"; printf '  %-11s %s\n' "$t" "$T_DESC"; done
}

main() {
  local cmd="${1:-help}"; shift || true
  case "$cmd" in
    setup)   cmd_setup "$@" ;;
    build)   cmd_build "$@" ;;
    clean)   cmd_clean "$@" ;;
    test)    cmd_test "$@" ;;
    sim)     cmd_sim "$@" ;;
    detect)  cmd_detect "$@" ;;
    monitor) cmd_monitor "$@" ;;
    flash)   cmd_flash "$@" ;;
    help|-h|--help) cmd_help ;;
    *) die "unknown command '$cmd' (./gg help)" ;;
  esac
}
main "$@"
